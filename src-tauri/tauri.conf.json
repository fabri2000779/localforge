{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalForge",
  "version": "0.1.3",
  "identifier": "com.localforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LocalForge",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Run game servers locally with a single click",
    "longDescription": "Spin up game servers on your own computer with no terminal commands and no Docker knowledge required. Powered by Pelican Panel's yolks container images.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": ".*"
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDODAzMEFEQjVEMTVDNkUKUldSdVhORzFyVENBdkZ3eEFrL3BuczIvZnBoSStjRlAySCt1bTdDNnBtdVg3dUcyWjlZY1p1c0wK",
      "endpoints": [
        "https://github.com/fabri2000779/localforge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
